# Runtime data — never commit a live database, it's regenerated from schema.sql
*.db
*.db-journal
*.db-wal
*.db-shm

# Digital twin / dashboard / home-snapshot live state — regenerated every control cycle
viewer/state.json
viewer/dashboard_state.json
viewer/home_snapshot.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Generated exports
*.md.bak
bom_export.md

# OS cruft
.DS_Store
Thumbs.db

# Secrets — never commit an API key
.env
backups/

# PlatformIO build artifacts for firmware/ — huge, regenerated by `pio run`
.pio/
.pioenvs/
.piolibdeps/

# Voice briefing (core/voice_briefing.py) — real downloaded TTS voice
# models are 60MB+ binaries, re-downloadable via
# `python3 -m piper.download_voices`, and the synthesized output itself
# is regenerated every daily report
voices/
viewer/daily_briefing.wav
