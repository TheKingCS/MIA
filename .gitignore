# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/
.venv/
venv/
env/

# --- M.I.A. runtime / user data (never commit personal data) ---
config/config.json
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# Reference Library content packs (.zim files) — deliberately NOT under
# data/, so core/backup_manager.py's data/ rglob never tries to sweep
# multi-gigabyte content packs into a config/data backup. See
# docs/HARDWARE.md's storage-split reasoning and docs/ROADMAP.md
# milestone 4.1. Default dev location only; a real deployment points
# reference_library.root_path at the separately-mounted bulk USB SSD.
reference_library/*
!reference_library/.gitkeep

# Voice interface models (Vosk STT + Piper TTS, docs/ROADMAP.md milestone
# 5.3) — large binary model files, fetched by deploy/download_voice_models.sh
# rather than committed. Same "not under data/" reasoning as the Reference
# Library above.
voice_models/*
!voice_models/.gitkeep

# Trip photos (docs/ROADMAP.md milestone 12.7, Trip Log) — imported image
# files copied per-trip by core/trip_manager.py. Same "large binary, not
# under data/" reasoning as Reference Library/voice models above.
trip_photos/*
!trip_photos/.gitkeep

# MIA Home financial snapshot ingestion (docs/VISION.md's "MIA Home's
# expanded scope" section, core/finance_manager.py) — a watched drop
# folder for externally-exported Kraken/real-estate JSON snapshots
# (user-provided external content, not app-owned data/*.json state,
# same reasoning as Reference Library/Trip Photos above).
financial_snapshots/*
!financial_snapshots/.gitkeep

# Trail map PDFs (core/trail_map_library.py, Maps module) — user-added
# official state park/trail map PDFs, downloaded or copied in by the
# user. Same "large-ish user-supplied binary, not under data/" reasoning
# as Reference Library/Trip Photos/financial snapshots above.
trail_maps/*
!trail_maps/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
