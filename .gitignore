# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/
.venv/
venv/
env/

# --- M.I.A. runtime / user data (never commit personal data) ---
config/config.json
data/*
!data/.gitkeep
# "My Hero's Path" skill taxonomy (core/skill_manager.py) — a seed data
# file meant to ship with the codebase and be hand-edited, same
# "tracked exception under data/" reasoning as .gitkeep above, NOT
# runtime/user state like everything else data/* excludes (that's
# data/skill_progress.json, which stays ignored).
!data/skill_definitions.json
# Mission Pathways (core/pathway_manager.py) — same "tracked seed
# content, hand-edited, not runtime state" reasoning as
# skill_definitions.json above. data/pathway_progress.json (real
# per-profile state) stays ignored.
!data/mission_pathways.json
logs/*
!logs/.gitkeep

# Reference Library content packs (.zim files) — deliberately NOT under
# data/, so core/backup_manager.py's data/ rglob never tries to sweep
# multi-gigabyte content packs into a config/data backup. See
# docs/HARDWARE.md's storage-split reasoning and docs/ROADMAP.md
# milestone 4.1. Default dev location only; a real deployment points
# reference_library.root_path at the separately-mounted bulk USB SSD.
reference_library/*
!reference_library/.gitkeep

# Voice interface models (Vosk STT + Piper TTS, docs/ROADMAP.md milestone
# 5.3) — large binary model files, fetched by deploy/download_voice_models.sh
# rather than committed. Same "not under data/" reasoning as the Reference
# Library above.
voice_models/*
!voice_models/.gitkeep

# Trip photos (docs/ROADMAP.md milestone 12.7, Trip Log) — imported image
# files copied per-trip by core/trip_manager.py. Same "large binary, not
# under data/" reasoning as Reference Library/voice models above.
trip_photos/*
!trip_photos/.gitkeep

# MIA Home financial snapshot ingestion (docs/VISION.md's "MIA Home's
# expanded scope" section, core/finance_manager.py) — a watched drop
# folder for externally-exported Kraken/real-estate JSON snapshots
# (user-provided external content, not app-owned data/*.json state,
# same reasoning as Reference Library/Trip Photos above).
financial_snapshots/*
!financial_snapshots/.gitkeep

# MIA Home Homestead snapshot ingestion (core/homestead_manager.py) —
# same watched-drop-folder pattern as financial_snapshots/ above, for
# externally-exported mia-homestead JSON snapshots. Real gap found live
# 2026-09-02: this entry was missing from the original
# core/homestead_manager.py commit (08d41f4), so imported/failed files
# would get accidentally tracked, unlike financial_snapshots/'s already-
# correct handling.
homestead_snapshots/*
!homestead_snapshots/.gitkeep

# MIA Lite field capture ingestion (core/lite_capture_manager.py) —
# same watched-drop-folder pattern as financial_snapshots/ above, for
# voice-note manifests+audio landing from a real field device (not
# built — see that module's own docstring). Added up front this time,
# not found as a gap after the fact like homestead_snapshots/ was.
lite_captures/*
!lite_captures/.gitkeep

# Trail map PDFs (core/trail_map_library.py, Maps module) — user-added
# official state park/trail map PDFs, downloaded or copied in by the
# user. Same "large-ish user-supplied binary, not under data/" reasoning
# as Reference Library/Trip Photos/financial snapshots above.
trail_maps/*
!trail_maps/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
