<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press MIA's icon: "Talk to MIA" opens her listening (Voice.kt). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="listen"
        android:enabled="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:shortcutShortLabel="@string/talk_short"
        android:shortcutLongLabel="@string/talk_long">
        <intent
            android:action="com.mia.phone.LISTEN"
            android:targetPackage="com.mia.phone"
            android:targetClass="com.mia.phone.MainActivity" />
    </shortcut>
</shortcuts>
