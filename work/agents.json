    "claude-code": {
      "kind": "cli",
      "command": "claude",
      "can": [
        "write",
        "review"
      ],
      "account": "Zac's Claude login"
    },
    "codex": {
      "kind": "cli",
      "command": "codex",
      "can": [
        "write",
        "review"
      ],
      "account": "Zac's ChatGPT login (codex login)"
