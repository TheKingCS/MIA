{
  "manifest_version": 1,
  "id": "notes",
  "name": "Journal",
  "icon": "📓",
  "tagline": "Write it down.",
  "description": "Dated, searchable, taggable journal entries.",
  "version": "1.0.0",
  "group": "Life, goals & self",
  "area": "personal_tools",
  "order": 31,
  "retired": false,
  "ask": "Make a note: call the plumber Friday.",
  "domains": [
    "notes",
    "journal",
    "private_journal"
  ],
  "entry": "web:journal.html",
  "components": {
    "interface": {
      "web": [
        "journal.html"
      ],
      "qt": [
        "modules/notes"
      ],
      "glasses": []
    },
    "services": [],
    "data": [
      "journal",
      "private_journal"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "add_note",
      "decide_field_recording",
      "delete_note",
      "get_journal_reflection",
      "get_journal_themes",
      "list_field_recordings",
      "list_notes",
      "read_private_journal"
    ],
    "actions": [
      "journal.add",
      "journal.delete",
      "journal.edit"
    ],
    "tiers": {
      "add_note": "act_within_grant",
      "decide_field_recording": "act_within_grant",
      "delete_note": "act_with_approval",
      "get_journal_reflection": "observe",
      "get_journal_themes": "observe",
      "list_field_recordings": "observe",
      "list_notes": "observe",
      "read_private_journal": "observe",
      "journal.add": "act_within_grant",
      "journal.delete": "act_with_approval",
      "journal.edit": "act_within_grant"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:journal",
    "stores.write:private_journal"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "journal_reflection"
    ]
  }
}
