{
  "manifest_version": 1,
  "id": "toolbox",
  "name": "Toolbox",
  "icon": "🧰",
  "tagline": "Quick tools.",
  "description": "Calculators, unit conversion, and other quick tools.",
  "version": "1.0.0",
  "group": "Knowledge, tools & system",
  "area": "garage",
  "order": 40,
  "retired": false,
  "ask": "Convert 5 gallons to liters.",
  "domains": [
    "toolbox"
