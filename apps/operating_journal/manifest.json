{
  "manifest_version": 1,
  "id": "operating_journal",
  "name": "Operating Journal",
  "icon": "🧭",
  "tagline": "How you mean to live, and how you do.",
  "description": "Your values, priorities, ideal day and week and rules, each checked against your records or rated by you (DEC-0097).",
  "version": "1.0.0",
  "group": "Life, goals & self",
  "area": "personal_tools",
  "order": 46,
  "retired": false,
  "ask": "Am I living how I said I want to?",
  "domains": [
    "operating_journal"
  ],
  "entry": "web:operating.html",
  "components": {
    "interface": {
      "web": [
        "operating.html"
      ],
      "qt": [],
      "glasses": [
        "directions",
        "how",
        "runs"
      ]
    },
    "services": [],
    "data": [
      "operating_journal"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "get_operating_journal",
      "remove_operating_line"
    ],
    "actions": [
      "operating.add",
      "operating.rate",
      "operating.remove"
    ],
    "tiers": {
      "get_operating_journal": "observe",
      "remove_operating_line": "act_with_approval",
      "operating.add": "act_within_grant",
      "operating.rate": "act_within_grant",
      "operating.remove": "act_within_grant"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:operating_journal"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "operating_journal"
    ]
  }
}
