{
  "manifest_version": 1,
  "id": "field_kit",
  "name": "Field Kit",
  "icon": "🛠",
  "tagline": "Devices and scripts.",
  "description": "Detect and manage connected devices; run your own scripts.",
  "version": "1.0.0",
  "group": "Knowledge, tools & system",
  "area": "smart_devices",
  "order": 42,
  "retired": false,
  "ask": "What devices are connected?",
  "domains": [
    "field_kit",
    "security"
  ],
  "entry": "web:field-kit.html",
  "components": {
    "interface": {
      "web": [
        "field-kit.html"
      ],
      "qt": [
        "modules/field_kit"
      ],
      "glasses": []
    },
    "services": [],
    "data": [
      "data_logger",
      "lite_captures",
      "scripts"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "calculate_subnet",
      "check_password_strength",
      "identify_hash",
      "list_connected_devices",
      "list_scripts",
      "scan_ports"
    ],
    "actions": [
      "sensor.remove"
    ],
    "tiers": {
      "calculate_subnet": "observe",
      "check_password_strength": "observe",
      "identify_hash": "act_within_grant",
      "list_connected_devices": "observe",
      "list_scripts": "observe",
      "scan_ports": "act_within_grant",
      "sensor.remove": "act_within_grant"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:data_logger",
    "stores.write:lite_captures",
    "stores.write:scripts"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "lite_captures"
    ]
  }
}
