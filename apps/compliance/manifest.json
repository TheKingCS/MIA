{
  "manifest_version": 1,
  "id": "compliance",
  "name": "Compliance",
  "icon": "📋",
  "tagline": "Every deadline, on time.",
  "description": "Tax filings and payments, permits, licences and renewals, each with its official source (DEC-0040).",
  "version": "1.0.0",
  "group": "Money & business",
  "area": "finances",
  "order": 6,
  "retired": false,
  "ask": "What's due for taxes?",
  "domains": [
    "compliance"
  ],
  "entry": "web:compliance.html",
  "components": {
    "interface": {
      "web": [
        "compliance.html"
      ],
      "qt": [],
      "glasses": [
        "due"
      ]
    },
    "services": [],
    "data": [
      "obligations"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "get_deadlines"
    ],
    "actions": [
      "obligation.add",
      "obligation.delete",
      "obligation.edit",
      "obligation.starters",
      "obligation.status",
      "obligation.verify"
    ],
    "tiers": {
      "get_deadlines": "observe",
      "obligation.add": "act_within_grant",
      "obligation.delete": "act_with_approval",
      "obligation.edit": "act_within_grant",
      "obligation.starters": "act_within_grant",
      "obligation.status": "act_within_grant",
      "obligation.verify": "act_within_grant"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:obligations"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "obligation_reminders"
    ]
  }
}
