{
  "manifest_version": 1,
  "id": "calendar",
  "name": "Calendar",
  "icon": "📅",
  "tagline": "Everything with a date.",
  "description": "Your events, plus upkeep, bills, meals, training and birthdays, by day.",
  "version": "1.0.0",
  "group": "Life, goals & self",
  "area": "personal_tools",
  "order": 7,
  "retired": false,
  "ask": "What's on my calendar this week?",
  "domains": [
    "calendar"
  ],
  "entry": "web:calendar.html",
  "components": {
    "interface": {
      "web": [
        "calendar.html"
      ],
      "qt": [],
      "glasses": []
    },
    "services": [],
    "data": [
      "calendar"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "add_calendar_event",
      "delete_calendar_event",
      "list_calendar_events"
    ],
    "actions": [
      "event.add",
      "event.delete"
    ],
    "tiers": {
      "add_calendar_event": "act_within_grant",
      "delete_calendar_event": "act_with_approval",
      "list_calendar_events": "observe",
      "event.add": "act_within_grant",
      "event.delete": "act_with_approval"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:calendar"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "calendar_digest"
    ]
  }
}
