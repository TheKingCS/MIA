{
  "manifest_version": 1,
  "id": "flock",
  "name": "Chickens",
  "icon": "🐔",
  "tagline": "Eggs, every day.",
  "description": "Your flock: eggs collected, the lay rate, feed cost per dozen, and cartons for the stand (DEC-0037).",
  "version": "1.0.0",
  "group": "Home, homestead & equipment",
  "area": "homestead",
  "order": 9,
  "retired": false,
  "ask": "How many eggs this week?",
  "domains": [
    "flock"
  ],
  "entry": "web:flock.html",
  "components": {
    "interface": {
      "web": [
        "flock.html"
      ],
      "qt": [],
      "glasses": [
        "eggs"
      ]
    },
    "services": [],
    "data": [
      "flock"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "get_eggs",
      "log_eggs",
      "start_hatch",
      "hatch_status"
    ],
    "actions": [
      "flock.add",
      "flock.birds",
      "flock.delete",
      "flock.edit",
      "flock.eggs",
      "flock.entry_delete",
      "flock.feed",
      "flock.use",
      "hatch.start"
    ],
    "tiers": {
      "get_eggs": "observe",
      "log_eggs": "act_within_grant",
      "flock.add": "act_within_grant",
      "flock.birds": "act_within_grant",
      "flock.delete": "act_with_approval",
      "flock.edit": "act_within_grant",
      "flock.eggs": "act_within_grant",
      "flock.entry_delete": "act_within_grant",
      "flock.feed": "act_within_grant",
      "flock.use": "act_within_grant",
      "start_hatch": "act_within_grant",
      "hatch_status": "observe",
      "hatch.start": "act_within_grant"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:flock"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "unusual"
    ]
  }
