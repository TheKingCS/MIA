{
  "manifest_version": 1,
  "id": "lab",
  "name": "The Lab",
  "icon": "🧪",
  "tagline": "Experiments and sensors.",
  "description": "Sensor testing, experiments, calibration, and graphs.",
  "version": "1.0.0",
  "group": "Knowledge, tools & system",
  "area": "smart_devices",
  "order": 41,
  "retired": false,
  "ask": "Start a temperature experiment.",
  "domains": [
    "lab"
  ],
  "entry": "web:lab.html",
  "components": {
    "interface": {
      "web": [
        "lab.html"
      ],
      "qt": [
        "modules/lab"
      ],
      "glasses": [
        "sensors"
      ]
    },
    "services": [],
    "data": [],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "delete_lab_reading",
      "list_lab_readings",
      "list_lab_series",
      "log_lab_reading"
    ],
    "actions": [
      "lab.approve",
      "lab.propose",
      "lab.reject",
      "lab_reading.add",
      "lab_reading.delete"
    ],
    "tiers": {
      "delete_lab_reading": "act_with_approval",
      "list_lab_readings": "observe",
      "list_lab_series": "observe",
      "log_lab_reading": "act_within_grant",
      "lab.approve": "act_within_grant",
      "lab.propose": "act_within_grant",
      "lab.reject": "act_within_grant",
      "lab_reading.add": "act_within_grant",
      "lab_reading.delete": "act_with_approval"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": []
  }
}
