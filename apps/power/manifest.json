{
  "manifest_version": 1,
  "id": "power",
  "name": "Power",
  "icon": "🔋",
  "tagline": "Energy, tracked.",
  "description": "Battery status and manual energy/utility tracking.",
  "version": "1.0.0",
  "group": "Home, homestead & equipment",
  "area": "smart_devices",
  "order": 26,
  "retired": false,
  "ask": "How's the battery?",
  "domains": [
    "power"
  ],
  "entry": "web:power.html",
  "components": {
    "interface": {
      "web": [
        "power.html"
      ],
      "qt": [
        "modules/power"
      ],
      "glasses": []
    },
    "services": [],
    "data": [
      "energy"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "get_energy",
      "get_power_status",
      "log_energy_reading",
      "power_picture",
      "generator_runtime",
      "set_power_load",
      "power_outage",
      "size_solar"
    ],
    "actions": [
      "energy.reading",
      "energy_source.add",
      "energy_source.delete",
      "energy_source.edit",
      "outage.start",
      "outage.end"
    ],
    "tiers": {
      "get_energy": "observe",
      "get_power_status": "observe",
      "power_picture": "observe",
      "generator_runtime": "observe",
      "set_power_load": "act_within_grant",
      "log_energy_reading": "act_within_grant",
      "energy.reading": "act_within_grant",
      "energy_source.add": "act_within_grant",
      "energy_source.delete": "act_with_approval",
      "energy_source.edit": "act_within_grant",
      "power_outage": "act_within_grant",
      "outage.start": "act_within_grant",
      "outage.end": "act_within_grant",
      "size_solar": "observe"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:energy"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "power"
    ]
  }
}
