{
  "manifest_version": 1,
  "id": "maps",
  "name": "Maps",
  "icon": "🗺",
  "tagline": "Know the ground.",
  "description": "Waypoints, a real offline basemap, and official trail maps.",
  "version": "1.0.0",
  "group": "Outdoors & field",
  "area": "recreation",
  "order": 37,
  "retired": false,
  "ask": "Which trail maps do I have?",
  "domains": [
    "maps"
  ],
  "entry": "web:maps.html",
  "components": {
    "interface": {
      "web": [
        "maps.html"
      ],
      "qt": [
        "modules/maps"
      ],
      "glasses": [
        "tracks"
      ]
    },
    "services": [],
    "data": [
      "gps_tracks",
      "places"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "add_trail_map_from_url",
      "arrive_place",
      "delete_trail_map",
      "list_places",
      "list_trail_maps"
    ],
    "actions": [
      "gps_track.add",
      "gps_track.delete",
      "map.area_keep",
      "map.area_remove",
      "map.checkin",
      "map.tak_share",
      "trail_map.delete"
    ],
    "tiers": {
      "add_trail_map_from_url": "act_within_grant",
      "arrive_place": "act_within_grant",
      "delete_trail_map": "act_with_approval",
      "list_places": "observe",
      "list_trail_maps": "observe",
      "gps_track.add": "act_within_grant",
      "gps_track.delete": "act_with_approval",
      "map.area_keep": "act_within_grant",
      "map.area_remove": "act_within_grant",
      "map.checkin": "act_within_grant",
      "map.tak_share": "act_with_approval",
      "trail_map.delete": "act_with_approval"
    },
    "outside": []
  },
  "uses": [],
  "permissions": [
    "stores.write:gps_tracks",
    "stores.write:places"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": []
  }
}
