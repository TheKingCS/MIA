      "resume_music": "act_within_grant",
      "set_music_volume": "act_within_grant",
      "stop_music": "act_within_grant",
      "music.scan": "act_within_grant",
      "playlist.add": "act_within_grant",
      "playlist.add_track": "act_within_grant",
      "playlist.delete": "act_with_approval",
      "playlist.remove_track": "act_within_grant",
      "playlist.rename": "act_within_grant",
      "track.delete": "act_with_approval",
      "find_on_youtube": "observe",
      "save_from_youtube": "act_within_grant",
