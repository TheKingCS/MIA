{
  "manifest_version": 1,
  "id": "greenhouse",
  "name": "Greenhouse",
  "icon": "🌱",
  "tagline": "Grow food. Grow freedom.",
  "description": "At-a-glance status for garden, greenhouse, and aquaponics assets.",
  "version": "1.0.0",
  "group": "Home, homestead & equipment",
  "area": "homestead",
  "order": 8,
  "retired": false,
  "ask": "What needs doing in the greenhouse?",
  "domains": [
    "maintenance",
    "development",
    "harvest",
    "orchard",
    "water"
  ],
  "entry": "web:greenhouse.html",
  "components": {
    "interface": {
      "web": [
        "greenhouse.html"
      ],
      "qt": [
        "modules/greenhouse"
      ],
      "glasses": [
        "next"
      ]
    },
    "services": [],
    "data": [
      "grow_lab",
      "homestead"
    ],
    "agents": [],
    "workflows": [],
    "integrations": []
  },
  "capabilities": {
    "tools": [
      "get_homestead_next_step",
      "fruit_tree_facts",
      "harvest_this_year",
      "log_harvest",
      "log_water_level",
      "orchard_this_month",
      "water_budget",
      "adjust_greenhouse"
    ],
    "actions": [
      "batch.add",
      "batch.delete",
      "batch.edit",
      "batch.harvest",
      "batch.lost",
      "experiment.add",
      "experiment.conclude",
      "experiment.delete",
      "experiment.edit",
      "experiment.include",
      "grow.range",
      "grow.reading",
      "grow.system",
      "grow.system_remove",
      "greenhouse.adjust"
    ],
    "tiers": {
      "get_homestead_next_step": "observe",
      "harvest_this_year": "observe",
      "orchard_this_month": "observe",
      "water_budget": "observe",
      "log_water_level": "act_within_grant",
      "fruit_tree_facts": "observe",
      "log_harvest": "act_within_grant",
      "batch.add": "act_within_grant",
      "batch.delete": "act_with_approval",
      "batch.edit": "act_within_grant",
      "batch.harvest": "act_within_grant",
      "batch.lost": "act_within_grant",
      "experiment.add": "act_within_grant",
      "experiment.conclude": "act_within_grant",
      "experiment.delete": "act_with_approval",
      "experiment.edit": "act_within_grant",
      "experiment.include": "act_within_grant",
      "grow.range": "act_within_grant",
      "grow.reading": "act_within_grant",
      "grow.system": "act_within_grant",
      "grow.system_remove": "act_within_grant",
      "adjust_greenhouse": "suggest",
      "greenhouse.adjust": "act_with_approval"
    },
    "outside": []
  },
  "uses": [
    "maintenance"
  ],
  "permissions": [
    "stores.write:grow_lab",
    "stores.write:homestead"
  ],
  "dependencies": [],
  "runtime": {
    "devices": {
      "pc": "full",
      "phone": "full",
      "glasses": "view",
      "voice": true
    },
    "background": [
      "greenhouse",
      "grow_alert",
      "homestead_snapshots"
    ]
  }
}
