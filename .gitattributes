# Windows batch files need CRLF; shell scripts must stay LF even on Windows checkouts.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
# MIA OS's session scripts have no extension, and run on Linux (FW-03).
os/files/mia-session text eol=lf
os/files/mia-shell text eol=lf
os/files/mia-login.conf text eol=lf
os/files/boot-stays-mounted.conf text eol=lf
os/files/finalize-needs-boot.conf text eol=lf
