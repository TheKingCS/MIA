# os/poc/vm/Containerfile.test
#
# PoC 2's second half and PoC 4's second (docs/mia_os/MIA_OS_CORE_ARCHITECTURE_OPEN_QUESTIONS.md section 2): the MIA OS
# image, booted in a virtual machine on GitHub's machine, updated to a second version and rolled back. This file adds
# ONLY what a machine nobody sits at needs to be tested from outside: SSH on (the test signs in as root with a key
# made for that run), and trust for the test's own throwaway registry on the VM's host. It is never the real image: the workflow
# (.github/workflows/mia-os-vm.yml) builds it from the real one and throws both away.
ARG BASE=localhost/mia-os:poc
FROM ${BASE}
ARG MARK=v1
# FW-04's rollback test: BREAK=selftest makes MIA's self-test fail, BREAK=login stops the login screen starting;
# greenboot must roll either back with no hand on the keyboard.
ARG BREAK=
RUN systemctl enable sshd \
 && mkdir -p /etc/containers/registries.conf.d \
 && printf '[[registry]]\nlocation = "10.0.2.2:5000"\ninsecure = true\n' > /etc/containers/registries.conf.d/90-poc-test.conf \
 && echo "${MARK}" > /usr/lib/mia/POC_IMAGE_MARK \
 && if [ "${BREAK}" = selftest ]; then printf 'import sys\nprint("FAIL broken on purpose")\nsys.exit(1)\n' \
        > /usr/lib/mia/core/self_test.py; fi \
 && if [ "${BREAK}" = login ]; then mkdir -p /usr/lib/systemd/system/plasmalogin.service.d \
        && printf '[Service]\nExecStart=\nExecStart=/bin/false\n' > /usr/lib/systemd/system/plasmalogin.service.d/broken.conf; fi
COPY serial-console.toml /usr/lib/bootc/kargs.d/90-poc-serial.toml
RUN bootc container lint
