#!/bin/bash
# os/files/mia-disk-enrol: makes the encrypted disk open with the TPM and a PIN, with a recovery key for the envelope
# (FW-05, DEC-0277, Q-106). Run once as root after the install, which used a temporary passphrase:
#   1. a recovery key is made and shown ONCE: write it down for the sealed envelope; it is never kept anywhere else
#      (not in MIA, not in a chat);
#   2. the TPM is enrolled, bound to PCR 7 (Secure Boot's state) and a PIN asked at each boot: an update keeps PCR 7
#      the same, so it never asks for the recovery key; Secure Boot turned off changes it, and the TPM refuses;
#   3. the install's temporary passphrase is removed, so only the PIN (with this TPM) or the recovery key open it.
# The device is the one holding the root filesystem, or the first argument. At a keyboard it asks for the install's
# passphrase and the new PIN. For the VM test only, with no terminal: PASSWORD gives the install's passphrase
# (systemd-cryptenroll reads it) and MIA_DISK_PIN the new PIN.
set -euo pipefail
dev="${1:-}"
if [ -z "$dev" ]; then
  mapper=$(findmnt -no SOURCE /sysroot 2>/dev/null || findmnt -no SOURCE /)
  dev=$(cryptsetup status "${mapper%%[*}" | awk '/device:/ {print $2}')
fi
cryptsetup isLuks "$dev" || { echo "$dev isn't an encrypted (LUKS) disk." >&2; exit 1; }
echo "== The recovery key for $dev (write it down now; it isn't kept anywhere):"
systemd-cryptenroll --recovery-key "$dev"
echo "== The TPM, with a PIN at each boot:"
if [ -n "${MIA_DISK_PIN:-}" ]; then
  NEWPIN="$MIA_DISK_PIN" systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 --tpm2-with-pin=yes "$dev"
else
  systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 --tpm2-with-pin=yes "$dev"
fi
echo "== The install's temporary passphrase removed:"
systemd-cryptenroll --wipe-slot=password "$dev"
systemd-cryptenroll "$dev"
