#!/bin/bash
# os/files/mia-update-apply: applies a staged update by restarting, only when it's safe (FW-04).
# 1. Something is staged (bootc says so); else nothing to do.
# 2. The computer is idle: every session's idle hint is set (or nobody is signed in). MIA_UPDATE_FORCE_IDLE=1 skips
#    this for the VM test.
# 3. A read-only snapshot of the homes is taken first (a Btrfs subvolume snapshot), so his files from just before
#    the update are kept whatever happens; without a subvolume for /var/home it says so and carries on.
# Then the restart: ostree applies the staged deployment while shutting down, and greenboot checks the new one.
set -u
staged=$(bootc status --format json | /usr/lib/mia/venv/bin/python -c 'import json,sys; s=json.load(sys.stdin).get("status",{}); print("yes" if s.get("staged") else "")')
[ -n "$staged" ] || { echo "Nothing staged."; exit 0; }
if [ "${MIA_UPDATE_FORCE_IDLE:-}" != "1" ]; then
  for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
    [ "$(loginctl show-session "$s" -p IdleHint --value)" = "yes" ] || { echo "Session $s isn't idle; later."; exit 0; }
  done
fi
mkdir -p /var/mia-snapshots
if btrfs subvolume show /var/home > /dev/null 2>&1; then
  btrfs subvolume snapshot -r /var/home "/var/mia-snapshots/home-$(date +%Y%m%d-%H%M%S)" && echo "Snapshot taken."
else
  echo "/var/home isn't its own Btrfs subvolume here: no snapshot (FW-05's disk layout makes it one)."
fi
echo "Applying the staged update: restarting."
systemctl reboot
