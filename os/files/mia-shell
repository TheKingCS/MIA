#!/bin/sh
# os/files/mia-shell: her shell window (gui/os_shell.py) on the image's own Python, from her code's folder.
# MIA_DESKTOP_SESSION_FILE is where her runtime says where she is (core/desktop_session.py).
export MIA_DESKTOP_SESSION_FILE="${XDG_RUNTIME_DIR}/mia/desktop.json"
# Her home, as her runtime's service has it (os/files/mia-runtime.service): the image's own folder is read-only.
export MIA_HOME="${MIA_HOME:-$HOME/.local/share/mia}"
cd /usr/lib/mia || exit 1
# Her runtime is a user service started before the desktop: hand his session's display to the user manager, so the
# apps and System Settings pages she opens (core/linux_apps.py, through systemd-run) appear on his screen.
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
# MIA_SHELL_ARGS: extra arguments for a test (KWin starts the session's program without arguments).
# The shell comes back by itself if it dies; closing it cleanly (exit 0) ends the session (FW-03). If it dies three
# times within 20 seconds of starting (it can't run on this machine), it stops trying: a terminal opens saying so,
# and closing that ends the session, back to the login screen where Plasma is one choice away.
quick=0
while :; do
  began=$(date +%s)
  # shellcheck disable=SC2086
  /usr/lib/mia/venv/bin/python -m gui.os_shell $MIA_SHELL_ARGS "$@" && exit 0
  [ -n "$MIA_SHELL_ARGS" ] && exit 1  # a test's one run
  if [ $(( $(date +%s) - began )) -lt 20 ]; then quick=$((quick + 1)); else quick=0; fi
  if [ "$quick" -ge 3 ]; then
    konsole -e sh -c 'echo "Her window keeps closing as soon as it opens."; echo "Her log: journalctl --user -b | tail -n 50"; echo "Close this window to go back to the login screen (choose Plasma there)."; exec sh'
    exit 1
  fi
  sleep $((quick * 2 + 1))
done
