{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheKingCS/MIA/docs/schema/appearance.schema.json",
  "title": "MIA's look as /api/shell sends it (display.theme)",
  "description": "The person's theme with their colour scheme over it and their layout and effects on it (core/appearance.py, DEC-0184). Theme, scheme and layout are independent choices; tokens are only the ones core/themes.py allows, the glass tiers clamped.",
  "type": "object",
  "required": ["id", "name", "tokens", "material", "scheme", "layout", "effects", "reduce_transparency"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
    "name": {"type": "string"},
    "tokens": {"type": "object", "additionalProperties": {"type": "string"}},
    "material": {"type": "string", "enum": ["solid", "glass", "chrome", "wire"]},
    "scheme": {"type": "string", "enum": ["theme", "cyan", "turquoise", "violet", "champagne", "ice", "rose"]},
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["density", "sidebar"],
      "properties": {
        "density": {"type": "string", "enum": ["comfortable", "compact"]},
        "sidebar": {"type": "string", "enum": ["full", "icons"]}
      }
    },
    "effects": {"type": "string", "enum": ["auto", "full", "light", "none"]},
    "reduce_transparency": {"type": "boolean"}
  }
}
