            "sources",
            "manual_debts_not_in_net_worth"
          ],
          "additionalProperties": false
        },
        "builds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "spent": {
