{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheKingCS/MIA/docs/schema/life_state.schema.json",
  "title": "MIA Life State v2",
  "description": "The person's whole picture as MIA computes it (core/context_assembler.py assemble_life_state_v2). The read model for every surface: the desktop, the phone (/api/state), mock-ups, glasses. Every section carries a status: REAL (stored records), DERIVED (computed from them), SIMULATED, STATIC (fixed text) or PLANNED (not built yet). Facts only: no section is written by the language model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "as_of",
    "generated_at",
    "person",
    "finances",
    "properties",
    "assets",
    "kitchen",
    "workout",
    "projects",
    "due",
    "missions_and_skills",
    "recent_wins",
    "friction",
    "goals",
    "links",
    "opportunities"
  ],
  "$defs": {
    "status": {
      "enum": [
        "REAL",
        "DERIVED",
        "SIMULATED",
        "STATIC",
        "PLANNED"
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z_]+:.+$",
      "description": "kind:id, the id the store uses (core/links.py KINDS)."
    },
    "suggested_action": {
      "type": [
        "object",
        "null"
      ],
      "description": "What a surface can propose for this item (POST /api/actions/propose). See docs/schema/action.schema.json.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "label",
        "params"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "version": {
      "enum": [
        2
      ]
    },
    "schema": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "description": "ISO date the state is for."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO time it was computed."
    },
    "person": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "household_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "household_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "child": {
          "type": "boolean"
        }
      },
      "required": [
        "profile_id",
        "name",
        "household_id",
        "household_name",
        "child"
      ],
      "additionalProperties": false,
      "description": "Who this is for: the signed-in person."
    },
    "finances": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
