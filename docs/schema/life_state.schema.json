              },
              "budget": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "remaining": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "spent",
              "budget",
              "remaining",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "total": {
                "type": "number"
              },
              "purchase": {
                "type": "number"
              },
              "upkeep": {
                "type": "number"
              },
              "per_hour": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "total",
              "purchase",
              "upkeep",
              "per_hour"
            ],
            "additionalProperties": false
          }
        },
        "monthly_plan": {
          "type": "object",
          "properties": {
            "expected_income": {
              "type": "number"
            },
            "bills": {
              "type": "number"
            },
            "debt_minimums": {
              "type": "number"
            },
            "gap": {
              "type": "number"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "expected_income",
            "bills",
            "debt_minimums",
            "gap",
            "note"
          ],
          "additionalProperties": false,
          "description": "Repeating income vs repeating bills and debt minimums, per month."
        }
      },
      "required": [
        "status",
        "source"
      ],
      "additionalProperties": false,
      "description": "Money (core/finance_summary.py) plus the monthly plan. Hidden for a child."
    },
    "properties": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
