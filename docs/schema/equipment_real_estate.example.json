{
  "scope": "real_estate",
  "name": "Real Estate",
  "icon": "🏘",
  "tagline": "Every building you own, and what's in it.",
  "default_category": "Appliance",
  "categories": [
    "Property",
    "Appliance"
  ],
  "forms": {
    "asset": {
      "noun": "asset",
      "id_param": "asset_id",
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "options": [],
          "default": null
        },
        {
          "name": "category",
          "label": "Kind",
          "type": "choice",
          "required": false,
          "options": [
            "Vehicle",
            "Power Equipment",
            "Appliance",
            "Property",
            "Garden/Plant",
            "Tool",
            "Other"
          ],
          "default": "Other"
        },
        {
          "name": "manufacturer",
          "label": "Make",
          "type": "text",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "model",
          "label": "Model",
          "type": "text",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "serial_number",
          "label": "Serial number",
          "type": "text",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "purchase_date",
          "label": "Bought on",
          "type": "date",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "purchase_price",
          "label": "Price paid",
          "type": "money",
          "required": false,
          "options": [],
          "default": 0.0
        },
        {
          "name": "warranty_until",
          "label": "Warranty until",
          "type": "date",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "required": false,
          "options": [],
          "default": null
        }
      ]
    },
    "maintenance_task": {
      "noun": "maintenance task",
      "id_param": "task_id",
      "fields": [
        {
          "name": "asset_id",
          "label": "For",
          "type": "asset",
          "required": true,
          "options": [],
          "default": null
        },
        {
          "name": "title",
          "label": "What to do",
          "type": "text",
          "required": true,
          "options": [],
          "default": null
        },
        {
          "name": "trigger_type",
          "label": "Goes by",
          "type": "choice",
          "required": false,
          "options": [
            "calendar",
            "runtime",
            "mileage",
            "cycles",
            "condition",
            "sensor"
          ],
          "default": "calendar"
        },
        {
          "name": "interval_days",
          "label": "Every (days)",
          "type": "int",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "meter_unit",
          "label": "Meter unit",
          "type": "text",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "meter_interval",
          "label": "Every (meter units)",
          "type": "amount",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "threshold_value",
          "label": "Due at reading",
          "type": "number",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "threshold_direction",
          "label": "Due when the reading is",
          "type": "choice",
          "required": false,
          "options": [
            "below",
            "above"
          ],
          "default": "below"
        },
        {
          "name": "priority",
          "label": "Priority",
          "type": "choice",
          "required": false,
          "options": [
            "low",
            "normal",
            "high"
          ],
          "default": "normal"
        },
        {
          "name": "last_completed",
          "label": "Last done",
          "type": "date",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "required": false,
          "options": [],
          "default": null
        }
      ]
    },
    "task_reading": {
      "noun": "reading",
      "id_param": "task_id",
      "fields": [
        {
          "name": "value",
          "label": "Reading",
          "type": "number",
          "required": true,
          "options": [],
          "default": null
        },
        {
          "name": "note",
          "label": "Note",
          "type": "textarea",
          "required": false,
          "options": [],
          "default": null
        }
      ]
    },
    "asset_reading": {
      "noun": "reading",
      "id_param": "asset_id",
      "fields": [
        {
          "name": "meter_name",
          "label": "Meter",
          "type": "text",
          "required": true,
          "options": [],
          "default": null
        },
        {
          "name": "value",
          "label": "Reading",
          "type": "number",
          "required": true,
          "options": [],
          "default": null
        },
        {
          "name": "unit",
          "label": "Unit",
          "type": "text",
          "required": false,
          "options": [],
          "default": null
        },
        {
          "name": "note",
          "label": "Note",
          "type": "textarea",
          "required": false,
          "options": [],
          "default": null
        }
      ]
    },
    "done": {
      "noun": "completion",
      "id_param": "task_id",
      "fields": [
        {
          "name": "meter_value",
          "label": "Meter reading now (optional)",
          "type": "number",
          "required": false,
          "options": [],
          "default": null
        }
      ]
    }
  },
